#!/usr/bin/env python3

import argparse

import helpers as hp

def main(opts):
    hp.acknowledge_deletion()

    namespaces = hp.STANDARD_NAMESPACES

    for namespace in namespaces:
        if namespace == "love":
            if opts.no_love:
                print("Skipping love namespace resources.")
                continue
            for api in hp.API_MAPPING[namespace]:
                command = hp.CMD_DELETE.format(
                    resource=api, name='--all', namespace=namespace
                )
                if opts.no_run:
                    print(command)
                else:
                    output = hp.run_cmd(command)
                    print(output)
            continue
        
        if namespace == "uws":
            command = hp.CMD_DELETE.format(
                resource=hp.API_MAPPING[namespace], name='-l csc-class=ocps', namespace=namespace
            )
        else:
            command = hp.CMD_DELETE.format(
                resource=hp.API_MAPPING[namespace], name='--all', namespace=namespace
            )

        if opts.no_run:
            print(command)
        else:
            output = hp.run_cmd(command)
            print(output)


if __name__ == "__main__":
    description = ["This program cleans up all deployed systems."]
    parser = argparse.ArgumentParser(
        description=" ".join(description),
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )

    parser.add_argument("--no-run", action="store_true", help="Do not run script, just print commands.")
    parser.add_argument("--no-love", action="store_true", help="Do not delete love namespace resources.")

    args = parser.parse_args()
    main(args)
